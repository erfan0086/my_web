# ---- سرور ----
PORT=3000
NODE_ENV=development

# ---- امنیت ----
# یک رشته تصادفی و بلند. با این دستور بسازید:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- دسترسی (اختیاری) ----
# اگر خالی باشد، پنل ادمین روی همه IPها باز می‌شود. برای محدود کردن:
# ADMIN_IP_ALLOWLIST=127.0.0.1,1.2.3.4
ADMIN_IP_ALLOWLIST=

# ---- قیمت‌گذاری خودکار (اختیاری) ----
# زمان‌بندی cron برای بروزرسانی خودکار نرخ ارز (پیش‌فرض: هر ۳۰ دقیقه)
PRICE_SCHEDULE=*/30 * * * *
# آدرسی که نرخ ارز را برمی‌گرداند (JSON). اگر خالی باشد، زمان‌بند فقط محاسبه را تکرار می‌کند.
# نمونه خروجی قابل قبول: {"USD": 100000, "EUR": 108000}  یا  {"rates": {"USD": 100000}}
RATE_SOURCE_URL=
# توکن اختیاری برای فراخوانی وب‌هوک قیمت بدون لاگین (اگر خالی باشد وب‌هوک غیرفعال است)
PRICE_WEBHOOK_TOKEN=

# ---- داده‌ها ----
DATA_DIR=./data
