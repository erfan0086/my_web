# ---- سرور ----
PORT=3000
NODE_ENV=development

# ---- امنیت ----
# یک رشته تصادفی بلند. با این دستور بسازید:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# محدود کردن IPهای مجاز برای پنل (اختیاری): ADMIN_IP_ALLOWLIST=1.2.3.4,5.6.7.8
ADMIN_IP_ALLOWLIST=

# ---- قیمت‌گذاری خودکار ----
# زمان‌بند بروزرسانی (cron). خالی بگذارید تا غیرفعال شود.
PRICE_SCHEDULE=*/30 * * * *
# منبع JSON نرخ ارز (اختیاری): {"USD": 100000} یا {"rates": {"USD": 100000}}
RATE_SOURCE_URL=
# توکن وب‌هوک قیمت (اگر خالی باشد وب‌هوک غیرفعال است)
PRICE_WEBHOOK_TOKEN=

# ---- داده‌ها ----
DATA_DIR=./data
